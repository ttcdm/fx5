#!/bin/sh
PROC=klogd
PIDS=$(ps -e | gawk '$4 ~ /\<'$PROC'\>/ && ($1 != mypid) {print $1}' mypid=$$)

if [ -z "$PIDS" ]; then
    echo "Unable to find \"$PROC\" process."
else
    for i in $PIDS
    do
       NAME=$(ps -e | gawk '$1 == '"$i"' && ($1 != mypid) {printf "%s", $4}' mypid=$$)
       if [ -n "$NAME" ]; then
           echo "Attempting to kill \"$NAME\" (PID $i)"
           if kill  $i; then
                sleep 1s
                continue
           else
                echo "Unable to stop process $i"
                exit 1
           fi
       fi
    done
fi
rm /tmp/klogd.out
klogd -f /tmp/klogd.out
