#!/bin/sh
#
# Run "what" on each of the HP libraries.
#
_mywhat='
@(#)whathp: $Revision: 1.4 $ $Date: 2000/08/29 20:05:43 $
'
#

usage() {
    exec >&2
    echo "Usage: $script [-v|--verbose]"
    exit 1
}

export PATH=/usr/X11R6/hp/bin:/bin:/usr/bin:$PATH
script=$(basename $0)
verbose=0
while [ $# -gt 0 ]; do
    case $1 in
        -v|--verbose) verbose=1;;
	*) usage;;
    esac
    shift
done

files="$(find /usr/GL/hp -type f -print) \
       $(find /usr/X11R6/hp -type f -print)"

for file in $files; do
    if [ $verbose -eq 1 ]; then
        ls -l ${file}*
    fi
    what $file
    [ $verbose -eq 1 ] && echo
done
